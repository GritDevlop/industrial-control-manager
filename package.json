{
  "name": "industrial-control-manager",
  "version": "1.0.0",
  "description": "工控资料聚合管理上位机软件",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "build": "electron-builder --win",
    "pack": "electron-builder --dir"
  },
  "keywords": ["industrial", "control", "management", "desktop"],
  "author": "Industrial Tech",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "electron-log": "^5.0.0",
    "axios": "^1.6.0"
  },
  "build": {
    "appId": "com.industrial.control.manager",
    "productName": "工控资料管理器",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "assets/**/*"
    ]
  }
}
